{
  "manifest_version": 3,
  "name": "IU Language Companion",
  "version": "0.1.0",
  "description": "A Chinese and Japanese dictionary for video: unknown words marked in the subtitles, meanings on hover.",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "src/background/service-worker.js",
    "scripts": ["src/background/service-worker.js"],
    "type": "module"
  },
  "action": {
    "default_title": "IU",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "sidebar_action": {
    "default_panel": "src/sidepanel/sidepanel.html",
    "default_title": "IU",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "iu@lhernandez0.github.io",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "storage",
    "sidePanel",
    "scripting",
    "webNavigation",
    "contextMenus"
  ],
  "host_permissions": [
    "https://*.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.youtube.com/*"],
      "js": ["src/content/page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["https://*.youtube.com/*"],
      "js": ["src/content/youtube-content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
