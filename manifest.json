{
  "manifest_version": 3,
  "name": "IU",
  "version": "0.1.0",
  "description": "Personal-use language-learning companion: reads a YouTube video's captions in the side panel.",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "IU"
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "sidePanel",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "https://*.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.youtube.com/*"],
      "js": ["src/content/page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["https://*.youtube.com/*"],
      "js": ["src/content/youtube-content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
