# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.*
# The negation matters: .env.example is the documented starting point ("copy
# .env.example to .env") and is meant to be committed, but `.env.*` matched it
# too, so it was ignored while the file's own header claimed it was committed.
!.env.example

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

